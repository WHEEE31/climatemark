# Everything is optional — ClimateMark runs with zero configuration.

# Port the server listens on. Hosting platforms set this automatically.
PORT=5000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Nominatim (OpenStreetMap geocoding) requires apps to identify themselves and
# returns 403 to those that don't. It also blocks by IP RANGE, so you can be
# blocked because of someone else on your host. ClimateMark falls back to Photon
# and then to raw coordinates, but set a real address anyway.
NOMINATIM_USER_AGENT=ClimateMark/1.0 (contact: you@example.com)
